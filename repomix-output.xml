<file path="src/App.tsx">
import { useState } from 'react'
import BudgetPage from './ui/components/Budget/BudgetPage'
import DebtPage from './ui/components/Debts/DebtPage'
import ExportImport from './ui/components/Common/ExportImport'
import Tabs from './ui/components/Common/Tabs'
import TransactionTable from './ui/components/Transactions/TransactionTable'
import { FinanceProvider } from './ui/context'

const tabs = [
  { key: 'transactions', label: 'Transactions' },
  { key: 'budgets', label: 'Budgets' },
  { key: 'debts', label: 'Debts' },
  { key: 'dashboard', label: 'Dashboard' },
  { key: 'yearly', label: 'Yearly' },
]

function PagePlaceholder({ name }: { name: string }) {
  return (
    <div className="flex items-center justify-center h-64 text-muted-foreground text-sm">
      {name} — coming soon
    </div>
  )
}

function AppShell() {
  const [activeTab, setActiveTab] = useState('transactions')

  return (
    <div className="min-h-screen bg-background">
      <header className="bg-card border-b border-border sticky top-0 z-40">
        <div className="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
          <h1 className="text-base font-heading font-bold">Finances</h1>
          <ExportImport />
        </div>
      </header>

      <main className="max-w-7xl mx-auto px-4 py-6">
        <Tabs tabs={tabs} active={activeTab} onChange={setActiveTab} />

        {activeTab === 'transactions' && <TransactionTable />}
        {activeTab === 'budgets' && <BudgetPage />}
        {activeTab === 'debts' && <DebtPage />}
        {activeTab === 'dashboard' && <PagePlaceholder name="Dashboard" />}
        {activeTab === 'yearly' && <PagePlaceholder name="Yearly Overview" />}
      </main>
    </div>
  )
}

export default function App() {
  return (
    <FinanceProvider>
      <AppShell />
    </FinanceProvider>
  )
}
</file>

<file path="src/ui/components/Transactions/TransactionForm.tsx">
import { useEffect, useState } from 'react'
import { v4 as uuid } from 'uuid'
import { Button } from '@/components/ui/button'
import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from '@/components/ui/select'
import { DEFAULT_CATEGORIES, PAYMENT_METHOD_LABELS } from '@/domain/constants'
import type { PaymentMethod, Transaction } from '@/domain/entities'
import { useFinance } from '@/ui/context'
import DebtConfigModal from './DebtConfigModal'

const PAYMENT_METHODS: PaymentMethod[] = ['CASH', 'DEBIT', 'CREDIT', 'PIX', 'MEAL_VOUCHER']

interface EditFormState {
  date: string
  amount: string
  description: string
  category: string
  paymentMethod: PaymentMethod
  referenceMonth: string
  installmentTotal: number
}

interface DebtConfig {
  userShare: number
  splits: Array<{ id: string; name: string; amount: number }>
}

interface TransactionFormProps {
  open: boolean
  onOpenChange: (open: boolean) => void
  editTransaction?: Transaction | null
}

export default function TransactionForm({
  open,
  onOpenChange,
  editTransaction,
}: TransactionFormProps) {
  const { dispatch } = useFinance()

  const [form, setForm] = useState<EditFormState>({
    date: '',
    amount: '',
    description: '',
    category: 'Other',
    paymentMethod: 'DEBIT',
    referenceMonth: '',
    installmentTotal: 1,
  })

  const [debtConfig, setDebtConfig] = useState<DebtConfig>({ userShare: 0, splits: [] })
  const [showDebtConfig, setShowDebtConfig] = useState(false)

  useEffect(() => {
    if (editTransaction) {
      setForm({
        date: editTransaction.date,
        amount: String(editTransaction.amount),
        description: editTransaction.description,
        category: editTransaction.category,
        paymentMethod: editTransaction.paymentMethod,
        referenceMonth: editTransaction.referenceMonth,
        installmentTotal: editTransaction.installment?.total ?? 1,
      })

      if (editTransaction.isDebt && editTransaction.debtSplits) {
        setDebtConfig({
          userShare: editTransaction.debtUserShare ?? 0,
          splits: editTransaction.debtSplits.map((s) => ({
            id: uuid(),
            name: s.debtorName,
            amount: s.amount,
          })),
        })
      } else {
        setDebtConfig({ userShare: 0, splits: [] })
      }
    }
  }, [editTransaction, open])

  function handleSave() {
    const amount = parseFloat(form.amount) || 0
    if (amount <= 0) {
      alert('Amount must be greater than 0')
      return
    }
    if (!form.description.trim()) {
      alert('Description is required')
      return
    }

    if (!editTransaction) return

    const updated: Transaction = {
      ...editTransaction,
      date: form.date,
      amount,
      description: form.description,
      category: form.category,
      paymentMethod: form.paymentMethod,
      referenceMonth: form.referenceMonth,
      installment: form.installmentTotal > 1 ? { current: editTransaction.installment?.current ?? 1, total: form.installmentTotal } : undefined,
      isDebt: debtConfig.splits.length > 0,
      debtUserShare: debtConfig.splits.length > 0 ? debtConfig.userShare : undefined,
      debtSplits: debtConfig.splits.length > 0 ? debtConfig.splits.map((s) => ({ debtorName: s.name, amount: s.amount })) : undefined,
    }

    dispatch({ type: 'UPDATE_TRANSACTION', payload: updated })
    onOpenChange(false)
  }

  const amount = parseFloat(form.amount) || 0

  return (
    <>
      <Dialog open={open} onOpenChange={onOpenChange}>
        <DialogContent className="sm:max-w-md">
          <DialogHeader>
            <DialogTitle>Edit Transaction</DialogTitle>
          </DialogHeader>

          <div className="space-y-3">
            {/* Date, Amount, Description - top priority */}
            <div className="grid grid-cols-2 gap-2">
              <div className="space-y-1">
                <Label className="text-xs">Date</Label>
                <Input
                  type="date"
                  value={form.date}
                  onChange={(e) => setForm((f) => ({ ...f, date: e.target.value }))}
                />
              </div>
              <div className="space-y-1">
                <Label className="text-xs">Amount (R$)</Label>
                <Input
                  type="number"
                  step="0.01"
                  value={form.amount}
                  onChange={(e) => setForm((f) => ({ ...f, amount: e.target.value }))}
                />
              </div>
            </div>

            <div className="space-y-1">
              <Label className="text-xs">Description</Label>
              <Input
                value={form.description}
                onChange={(e) => setForm((f) => ({ ...f, description: e.target.value }))}
              />
            </div>

            {/* Category, Payment, RefMonth */}
            <div className="grid grid-cols-2 gap-2">
              <div className="space-y-1">
                <Label className="text-xs">Category</Label>
                <Select value={form.category} onValueChange={(v) => setForm((f) => ({ ...f, category: v ?? 'Other' }))}>
                  <SelectTrigger>
                    <SelectValue />
                  </SelectTrigger>
                  <SelectContent>
                    {DEFAULT_CATEGORIES.map((c) => (
                      <SelectItem key={c} value={c}>
                        {c}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>
              <div className="space-y-1">
                <Label className="text-xs">Payment Method</Label>
                <Select value={form.paymentMethod} onValueChange={(v) => setForm((f) => ({ ...f, paymentMethod: (v ?? 'DEBIT') as PaymentMethod }))}>
                  <SelectTrigger>
                    <SelectValue />
                  </SelectTrigger>
                  <SelectContent>
                    {PAYMENT_METHODS.map((pm) => (
                      <SelectItem key={pm} value={pm}>
                        {PAYMENT_METHOD_LABELS[pm] ?? pm}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>
            </div>

            <div className="space-y-1">
              <Label className="text-xs">Reference Month</Label>
              <Input
                type="month"
                value={form.referenceMonth}
                onChange={(e) => setForm((f) => ({ ...f, referenceMonth: e.target.value }))}
              />
            </div>

            {/* Installments (if CREDIT) */}
            {form.paymentMethod === 'CREDIT' && (
              <div className="space-y-1">
                <Label className="text-xs">Installments</Label>
                <Input
                  type="number"
                  min="1"
                  max="48"
                  value={form.installmentTotal}
                  onChange={(e) => setForm((f) => ({ ...f, installmentTotal: Math.max(1, parseInt(e.target.value, 10) || 1) }))}
                />
              </div>
            )}

            {/* Debt configuration */}
            <div className="border-t pt-3 space-y-2">
              <div className="flex items-center justify-between">
                <Label className="text-xs font-medium">Debt Configuration</Label>
                {debtConfig.splits.length > 0 && (
                  <Button variant="ghost" size="xs" onClick={() => setShowDebtConfig(true)}>
                    {debtConfig.splits.length} debtor{debtConfig.splits.length !== 1 ? 's' : ''}
                  </Button>
                )}
              </div>

              {debtConfig.splits.length === 0 ? (
                <Button
                  variant="outline"
                  size="sm"
                  className="w-full"
                  onClick={() => setShowDebtConfig(true)}
                >
                  Configure debt splits
                </Button>
              ) : (
                <div className="text-xs space-y-1 bg-muted/50 p-2 rounded">
                  {debtConfig.userShare > 0 && (
                    <div>
                      Me: <span className="font-mono">R$ {debtConfig.userShare.toFixed(2)}</span>
                    </div>
                  )}
                  {debtConfig.splits.map((s) => (
                    <div key={s.id}>
                      {s.name}: <span className="font-mono">R$ {s.amount.toFixed(2)}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div className="flex gap-2 justify-end pt-4">
            <Button variant="outline" onClick={() => onOpenChange(false)}>
              Cancel
            </Button>
            <Button onClick={handleSave}>Update</Button>
          </div>
        </DialogContent>
      </Dialog>

      <DebtConfigModal
        open={showDebtConfig}
        onOpenChange={setShowDebtConfig}
        config={debtConfig}
        onConfigChange={setDebtConfig}
        totalAmount={amount}
      />
    </>
  )
}
</file>

