<file path="src/ui/components/Debts/DebtPage.tsx">
import { CheckCircleIcon, UserIcon } from '@phosphor-icons/react'
import { useMemo } from 'react'
import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table'
import { activeDebts, daysSince } from '@/domain/calculations'
import { useFinance } from '@/ui/context'

function formatCurrency(n: number): string {
  return `R$ ${n.toFixed(2)}`
}

function DebtUrgency({ days }: { days: number }) {
  const color =
    days > 30
      ? 'text-red-600 bg-red-50 dark:bg-red-900/20'
      : days > 15
        ? 'text-amber-600 bg-amber-50 dark:bg-amber-900/20'
        : 'text-green-600 bg-green-50 dark:bg-green-900/20'
  return (
    <Badge variant="outline" className={color}>
      {days}d
    </Badge>
  )
}

export default function DebtPage() {
  const { state, dispatch } = useFinance()

  const debts = useMemo(() => activeDebts(state.transactions), [state.transactions])

  function handleSettle(id: string) {
    dispatch({ type: 'SETTLE_TRANSACTION', payload: id, settled: true })
  }

  return (
    <div className="space-y-4">
      <h2 className="text-sm font-semibold">Active Debts (who owes me)</h2>

      {debts.length === 0 ? (
        <div className="border border-border p-8 text-center text-muted-foreground text-sm">
          No active debts.
        </div>
      ) : (
        <div className="border border-border">
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Debtor</TableHead>
                <TableHead>Description</TableHead>
                <TableHead className="text-right">Amount</TableHead>
                <TableHead>Age</TableHead>
                <TableHead>Date Lent</TableHead>
                <TableHead>Splits</TableHead>
                <TableHead className="text-right">Action</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {debts.map((tx) => {
                const days = daysSince(tx.date)
                const splits = tx.debtSplits?.filter((s) => s.amount > 0) ?? []
                return (
                  <TableRow key={tx.id}>
                    <TableCell className="font-medium">
                      <div className="flex items-center gap-1">
                        <UserIcon className="size-3" />
                        {splits.length === 1 ? splits[0].debtorName : tx.debtorName || 'Multiple'}
                      </div>
                    </TableCell>
                    <TableCell>{tx.description}</TableCell>
                    <TableCell className="text-right font-mono">
                      {formatCurrency(tx.amount)}
                    </TableCell>
                    <TableCell>
                      <DebtUrgency days={days} />
                    </TableCell>
                    <TableCell className="text-muted-foreground">{tx.date}</TableCell>
                    <TableCell>
                      {splits.length > 1 ? (
                        <div className="text-xs space-y-0.5">
                          {splits.map((s, i) => (
                            <div key={i} className="text-muted-foreground">
                              {s.debtorName}: {formatCurrency(s.amount)}
                            </div>
                          ))}
                        </div>
                      ) : splits.length === 1 ? (
                        <span className="text-xs text-muted-foreground">100%</span>
                      ) : (
                        <span className="text-xs text-muted-foreground">—</span>
                      )}
                    </TableCell>
                    <TableCell className="text-right">
                      <Button variant="ghost" size="icon-sm" onClick={() => handleSettle(tx.id)}>
                        <CheckCircleIcon />
                      </Button>
                    </TableCell>
                  </TableRow>
                )
              })}
            </TableBody>
          </Table>
        </div>
      )}
    </div>
  )
}
</file>

<file path="src/ui/components/Transactions/DebtConfigModal.tsx">
import { LightningAIcon, PlusIcon, TrashIcon } from '@phosphor-icons/react'
import { useState } from 'react'
import { v4 as uuid } from 'uuid'
import { Button } from '@/components/ui/button'
import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'

interface DebtSplit {
  id: string
  name: string
  amount: number
}

interface DebtConfig {
  userShare: number
  splits: DebtSplit[]
}

interface DebtConfigModalProps {
  open: boolean
  onOpenChange: (open: boolean) => void
  config: DebtConfig
  onConfigChange: (config: DebtConfig) => void
  totalAmount: number
}

export default function DebtConfigModal({
  open,
  onOpenChange,
  config,
  onConfigChange,
  totalAmount,
}: DebtConfigModalProps) {
  const [tempConfig, setTempConfig] = useState<DebtConfig>(config)

  const assignedDebtors = tempConfig.splits.reduce((s, d) => s + d.amount, 0)
  const assignedTotal = tempConfig.userShare + assignedDebtors
  const remaining = Math.max(0, totalAmount - assignedTotal)
  const isBalanced = Math.abs(remaining) < 0.01

  function handleAddPerson() {
    setTempConfig((c) => ({
      ...c,
      splits: [...c.splits, { id: uuid(), name: '', amount: 0 }],
    }))
  }

  function handleUpdateSplit(id: string, patch: Partial<DebtSplit>) {
    setTempConfig((c) => ({
      ...c,
      splits: c.splits.map((s) => (s.id === id ? { ...s, ...patch } : s)),
    }))
  }

  function handleRemoveSplit(id: string) {
    setTempConfig((c) => ({
      ...c,
      splits: c.splits.filter((s) => s.id !== id),
    }))
  }

  function handleFillRemainder(id: string) {
    setTempConfig((c) => ({
      ...c,
      splits: c.splits.map((s) => (s.id === id ? { ...s, amount: remaining } : s)),
    }))
  }

  function handleSplitEvenly() {
    const count = tempConfig.splits.length
    if (count === 0) return
    const perPerson = Math.round((totalAmount / count) * 100) / 100
    const remainder = Math.round((totalAmount - perPerson * count) * 100) / 100
    setTempConfig((c) => ({
      ...c,
      userShare: 0,
      splits: c.splits.map((s, i) => ({
        ...s,
        amount: i === c.splits.length - 1 ? perPerson + remainder : perPerson,
      })),
    }))
  }

  function handleSave() {
    // If totalAmount is 0, the user will auto-fill it from the config total
    // If totalAmount > 0, validate that splits don't exceed it
    if (totalAmount > 0 && !isBalanced) {
      alert(
        `Debt splits must total R$ ${totalAmount.toFixed(2)} (currently ${assignedTotal.toFixed(2)})`,
      )
      return
    }
    onConfigChange(tempConfig)
    onOpenChange(false)
  }

  function handleCancel() {
    setTempConfig(config)
    onOpenChange(false)
  }

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-lg">
        <DialogHeader>
          <DialogTitle>
            Configure Debt Split
            {totalAmount === 0 ? ' (will set amount)' : null}
          </DialogTitle>
        </DialogHeader>

        <div className="space-y-4">
          {/* Me row */}
          <div className="border-b pb-3">
            <Label className="text-xs font-medium mb-2 block">Your share (R$)</Label>
            <div className="flex items-center gap-2">
              <span className="text-sm font-medium flex-1">Me</span>
              <Input
                type="number"
                step="0.01"
                min="0"
                value={tempConfig.userShare}
                onChange={(e) =>
                  setTempConfig((c) => ({
                    ...c,
                    userShare: parseFloat(e.target.value) || 0,
                  }))
                }
                className="w-28"
              />
            </div>
          </div>

          {/* Debtors */}
          <div className="space-y-2">
            <div className="flex items-center justify-between">
              <Label className="text-xs font-medium">Debtors</Label>
              <Button variant="ghost" size="xs" onClick={handleAddPerson}>
                <PlusIcon className="size-3" /> Add person
              </Button>
            </div>

            {tempConfig.splits.length === 0 ? (
              <div className="text-xs text-muted-foreground py-4 text-center border border-dashed p-2">
                No debtors yet. Click "Add person" to get started.
              </div>
            ) : (
              <>
                {tempConfig.splits.map((split) => (
                  <div key={split.id} className="flex gap-2 items-center">
                    <Input
                      placeholder="Name"
                      value={split.name}
                      onChange={(e) => handleUpdateSplit(split.id, { name: e.target.value })}
                      className="flex-1"
                    />
                    <Input
                      type="number"
                      step="0.01"
                      min="0"
                      placeholder="Amount"
                      value={split.amount}
                      onChange={(e) =>
                        handleUpdateSplit(split.id, { amount: parseFloat(e.target.value) || 0 })
                      }
                      className="w-28"
                    />
                    <Button
                      variant="ghost"
                      size="icon-xs"
                      title="Fill with remaining amount"
                      onClick={() => handleFillRemainder(split.id)}
                      disabled={remaining < 0.01}
                    >
                      <LightningAIcon />
                    </Button>
                    <Button
                      variant="ghost"
                      size="icon-xs"
                      onClick={() => handleRemoveSplit(split.id)}
                    >
                      <TrashIcon />
                    </Button>
                  </div>
                ))}

                {tempConfig.splits.length > 0 && (
                  <Button
                    variant="outline"
                    size="sm"
                    className="w-full"
                    onClick={handleSplitEvenly}
                  >
                    Split evenly across {tempConfig.splits.length} person
                    {tempConfig.splits.length !== 1 ? 's' : ''}
                  </Button>
                )}
              </>
            )}
          </div>

          {/* Balance indicator */}
          <div
            className={`flex items-center justify-between text-xs p-2 rounded border ${
              totalAmount === 0
                ? 'bg-blue-50 border-blue-200 text-blue-700 dark:bg-blue-900/20 dark:border-blue-800 dark:text-blue-400'
                : isBalanced
                  ? 'bg-green-50 border-green-200 text-green-700 dark:bg-green-900/20 dark:border-green-800 dark:text-green-400'
                  : 'bg-yellow-50 border-yellow-200 text-yellow-700 dark:bg-yellow-900/20 dark:border-yellow-800 dark:text-yellow-400'
            }`}
          >
            <span>{totalAmount === 0 ? 'Amount will be set to:' : 'Balance:'}</span>
            <span className="font-mono font-medium">
              {totalAmount === 0
                ? `R$ ${(tempConfig.userShare + tempConfig.splits.reduce((s, d) => s + d.amount, 0)).toFixed(2)}`
                : `R$ ${tempConfig.userShare.toFixed(2)} + R$ ${assignedDebtors.toFixed(2)} = R$ ${assignedTotal.toFixed(2)} / R$ ${totalAmount.toFixed(2)}`}
            </span>
          </div>

          {!isBalanced && remaining !== 0 && (
            <div className="text-xs text-muted-foreground">
              Remaining: R$ {remaining.toFixed(2)}
            </div>
          )}
        </div>

        {/* Footer */}
        <div className="flex gap-2 justify-end pt-4">
          <Button variant="outline" onClick={handleCancel}>
            Cancel
          </Button>
          <Button onClick={handleSave} disabled={totalAmount > 0 && !isBalanced}>
            {totalAmount === 0 ? 'Set Amount & Continue' : 'Save'}
          </Button>
        </div>
      </DialogContent>
    </Dialog>
  )
}
</file>

<file path="src/ui/components/Transactions/QuickAddRow.tsx">
import { PlusIcon, UsersIcon } from '@phosphor-icons/react'
import React, { useEffect, useRef } from 'react'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from '@/components/ui/select'
import { TableCell, TableRow } from '@/components/ui/table'
import { DEFAULT_CATEGORIES, PAYMENT_METHOD_LABELS } from '@/domain/constants'
import type { PaymentMethod } from '@/domain/entities'

const PAYMENT_METHODS: PaymentMethod[] = ['CASH', 'DEBIT', 'CREDIT', 'PIX', 'MEAL_VOUCHER']

interface QuickAddRowState {
  date: string
  amount: string
  description: string
  category: string | null
  paymentMethod: PaymentMethod | null
  installmentTotal: number
  isDebt: boolean
}

interface DebtConfig {
  userShare: number
  splits: Array<{ id: string; name: string; amount: number }>
}

interface QuickAddRowProps {
  refMonth: string
  onAdd: (row: QuickAddRowState, refMonth: string, debtConfig?: DebtConfig) => void
  isFilteredMonth: boolean
  onOpenDebtModal?: (callback: (config: DebtConfig) => void, totalAmount: number) => void
}

export default function QuickAddRow({
  refMonth,
  onAdd,
  isFilteredMonth,
  onOpenDebtModal,
}: QuickAddRowProps) {
  const [row, setRow] = React.useState<QuickAddRowState>({
    date: new Date().toISOString().slice(0, 10),
    amount: '',
    description: '',
    category: null,
    paymentMethod: null,
    installmentTotal: 1,
    isDebt: false,
  })

  const [selectedRefMonth, setSelectedRefMonth] = React.useState(refMonth)
  const [debtConfig, setDebtConfig] = React.useState<DebtConfig>({ userShare: 0, splits: [] })

  const dateInputRef = useRef<HTMLInputElement>(null)

  useEffect(() => {
    // Auto-focus date input when row mounts
    dateInputRef.current?.focus()
  }, [])

  function handleKeyDown(e: React.KeyboardEvent) {
    if (e.key === 'Enter') {
      handleAdd()
    }
  }

  function handleAdd() {
    const amount = parseFloat(row.amount) || 0

    if (!row.date) {
      alert('Date is required')
      return
    }
    if (amount <= 0) {
      alert('Amount is required and must be greater than 0')
      return
    }
    if (!row.category) {
      alert('Category is required')
      return
    }
    if (!row.paymentMethod) {
      alert('Payment method is required')
      return
    }

    onAdd(
      row as Omit<QuickAddRowState, 'category' | 'paymentMethod'> & {
        category: string
        paymentMethod: PaymentMethod
      },
      selectedRefMonth,
      debtConfig.splits.length > 0 ? debtConfig : undefined,
    )

    // Reset for next entry
    setRow({
      date: new Date().toISOString().slice(0, 10),
      amount: '',
      description: '',
      category: null,
      paymentMethod: null,
      installmentTotal: 1,
      isDebt: false,
    })
    setDebtConfig({ userShare: 0, splits: [] })
    dateInputRef.current?.focus()
  }

  return (
    <TableRow className="bg-muted/30 hover:bg-muted/50">
      <TableCell className="p-1 w-20">
        {isFilteredMonth ? (
          <div className="text-xs text-muted-foreground pt-2">{refMonth}</div>
        ) : (
          <Input
            type="month"
            value={selectedRefMonth}
            onChange={(e) => setSelectedRefMonth(e.target.value)}
            onKeyDown={handleKeyDown}
            className="h-6 text-xs"
          />
        )}
      </TableCell>
      <TableCell className="p-1 w-20">
        <Input
          ref={dateInputRef}
          type="date"
          value={row.date}
          onChange={(e) => setRow((r) => ({ ...r, date: e.target.value }))}
          onKeyDown={handleKeyDown}
          className="h-6 text-xs"
        />
      </TableCell>
      <TableCell className="p-1 flex-1">
        <Input
          placeholder="Description"
          value={row.description}
          onChange={(e) => setRow((r) => ({ ...r, description: e.target.value }))}
          onKeyDown={handleKeyDown}
          className="h-6 text-xs"
        />
      </TableCell>
      <TableCell className="p-1 w-20">
        <Select
          value={row.category ?? ''}
          onValueChange={(v) => setRow((r) => ({ ...r, category: v || null }))}
        >
          <SelectTrigger className="h-6 text-xs">
            <SelectValue placeholder="Category" />
          </SelectTrigger>
          <SelectContent>
            {DEFAULT_CATEGORIES.map((c) => (
              <SelectItem key={c} value={c} className="text-xs">
                {c}
              </SelectItem>
            ))}
          </SelectContent>
        </Select>
      </TableCell>
      <TableCell className="p-1 w-24">
        <Input
          type="number"
          step="0.01"
          min="0"
          placeholder="0.00"
          value={row.amount}
          onChange={(e) => setRow((r) => ({ ...r, amount: e.target.value }))}
          onKeyDown={handleKeyDown}
          className="h-6 text-xs text-right font-mono"
        />
      </TableCell>
      <TableCell className="p-1 w-20">
        <Select
          value={row.paymentMethod ?? ''}
          onValueChange={(v) =>
            setRow((r) => ({ ...r, paymentMethod: (v || null) as PaymentMethod | null }))
          }
        >
          <SelectTrigger className="h-6 text-xs">
            <SelectValue placeholder="Payment" />
          </SelectTrigger>
          <SelectContent>
            {PAYMENT_METHODS.map((pm) => (
              <SelectItem key={pm} value={pm} className="text-xs">
                {PAYMENT_METHOD_LABELS[pm] ?? pm}
              </SelectItem>
            ))}
          </SelectContent>
        </Select>
      </TableCell>
      <TableCell className="p-1 w-16 text-center">
        {row.paymentMethod === 'CREDIT' && (
          <Input
            type="number"
            min="1"
            max="48"
            value={row.installmentTotal}
            onChange={(e) =>
              setRow((r) => ({
                ...r,
                installmentTotal: Math.max(1, parseInt(e.target.value, 10) || 1),
              }))
            }
            onKeyDown={handleKeyDown}
            className="h-6 text-xs text-center"
          />
        )}
      </TableCell>
      <TableCell className="p-1 w-32">
        <Button
          size="icon-xs"
          variant={debtConfig.splits.length > 0 ? 'default' : 'ghost'}
          onClick={() => {
            if (onOpenDebtModal) {
              const amount = parseFloat(row.amount) || 0
              onOpenDebtModal((config) => {
                setDebtConfig(config)
                // If amount was 0, auto-fill with the debt total
                if (amount === 0) {
                  const total = config.userShare + config.splits.reduce((s, d) => s + d.amount, 0)
                  setRow((r) => ({ ...r, amount: String(total) }))
                }
              }, amount)
            }
          }}
          title={
            debtConfig.splits.length > 0 ? `${debtConfig.splits.length} debtors` : 'Add debt splits'
          }
        >
          <UsersIcon className="size-3" />
          {debtConfig.splits.length > 0 && (
            <span className="ml-1 text-xs">{debtConfig.splits.length}</span>
          )}
        </Button>
      </TableCell>
      <TableCell className="p-1 text-right w-20">
        <Button size="icon-xs" onClick={handleAdd} title="Add transaction (or press Enter)">
          <PlusIcon />
        </Button>
      </TableCell>
    </TableRow>
  )
}
