<file path="src/data/exportImport.ts">
import { v4 as uuid } from 'uuid'
import type { FinanceData, Transaction } from '../domain/entities'

export function exportJSON(data: FinanceData): void {
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' })
  downloadBlob(blob, `finances-${new Date().toISOString().slice(0, 10)}.json`)
}

export function importJSON(json: string): FinanceData {
  const data = JSON.parse(json) as FinanceData
  if (!Array.isArray(data.transactions) || !Array.isArray(data.budgets)) {
    throw new Error('Invalid format: expected { transactions: [], budgets: [] }')
  }
  return data
}

export function exportCSV(transactions: Transaction[]): void {
  const headers = [
    'date',
    'type',
    'amount',
    'category',
    'paymentMethod',
    'description',
    'referenceMonth',
    'isDebt',
    'debtorName',
    'debtUserShare',
    'debtNames',
    'debtAmounts',
    'isSettled',
    'installmentTotal',
    'installmentCurrent',
    'parentId',
    'groupId',
  ]
  const rows = transactions.map((t) => {
    const debtNames = t.debtSplits?.map((d) => d.debtorName).join('/') ?? ''
    const debtorAmounts = t.debtSplits?.map((d) => d.amount).join('/') ?? ''
    const debtAmounts = t.debtSplits?.length ? debtorAmounts : ''

    return [
      t.date,
      t.type,
      String(t.amount),
      t.category,
      t.paymentMethod,
      t.description,
      t.referenceMonth,
      String(t.isDebt),
      t.debtorName ?? '',
      String(t.debtUserShare ?? 0),
      debtNames,
      debtAmounts,
      String(t.isSettled),
      t.installment?.total?.toString() ?? '',
      t.installment?.current?.toString() ?? '',
      t.parentId ?? '',
      t.groupId ?? '',
    ]
  })
  const csv = [
    headers.join(','),
    ...rows.map((r) => r.map((cell) => `"${cell.replace(/"/g, '""')}"`).join(',')),
  ].join('\n')
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' })
  downloadBlob(blob, `finances-${new Date().toISOString().slice(0, 10)}.csv`)
}

export function importCSV(csv: string): Transaction[] {
  const lines = csv.trim().split('\n')
  if (lines.length < 2) throw new Error('CSV must have a header row and at least one data row')

  const headers = parseCSVLine(lines[0])
  const requiredFields = ['date', 'type', 'amount', 'category', 'paymentMethod']
  for (const field of requiredFields) {
    if (!headers.includes(field)) throw new Error(`Missing required column: ${field}`)
  }

  const transactions: Transaction[] = []
  for (let i = 1; i < lines.length; i++) {
    const line = lines[i].trim()
    if (!line) continue
    const values = parseCSVLine(line)
    if (values.length !== headers.length) continue

    const row = Object.fromEntries(headers.map((h, idx) => [h, values[idx]]))

    const date = row.date
    const referenceMonth = row.referenceMonth || date.slice(0, 7)

    const t: Transaction = {
      id: uuid(),
      type: row.type as 'INCOME' | 'EXPENSE',
      date,
      referenceMonth,
      description: row.description || '',
      amount: parseFloat(row.amount) || 0,
      category: row.category || 'Other',
      paymentMethod: row.paymentMethod as Transaction['paymentMethod'],
      installment: row.installmentTotal
        ? {
            current: parseInt(row.installmentCurrent, 10) || 1,
            total: parseInt(row.installmentTotal, 10) || 1,
          }
        : undefined,
      parentId: row.parentId || undefined,
      groupId: row.groupId || undefined,
      isDebt: row.isDebt === 'true',
      debtorName: row.debtorName || undefined,
      isSettled: row.isSettled === 'true',
    }

    if (row.debtNames && row.debtAmounts) {
      const names = row.debtNames.split('/').filter(Boolean)
      const amounts = row.debtAmounts.split('/').filter(Boolean)
      if (names.length === amounts.length && names.length > 0) {
        t.debtSplits = names.map((name, i) => ({
          debtorName: name,
          amount: parseFloat(amounts[i]) || 0,
        }))
        t.debtUserShare = parseFloat(row.debtUserShare) || 0
      }
    }

    transactions.push(t)
  }

  return transactions
}

function parseCSVLine(line: string): string[] {
  const result: string[] = []
  let current = ''
  let inQuotes = false
  for (let i = 0; i < line.length; i++) {
    const ch = line[i]
    if (ch === '"') {
      if (inQuotes && line[i + 1] === '"') {
        current += '"'
        i++
      } else {
        inQuotes = !inQuotes
      }
    } else if (ch === ',' && !inQuotes) {
      result.push(current)
      current = ''
    } else {
      current += ch
    }
  }
  result.push(current)
  return result
}

function downloadBlob(blob: Blob, filename: string): void {
  const url = URL.createObjectURL(blob)
  const a = document.createElement('a')
  a.href = url
  a.download = filename
  a.click()
  URL.revokeObjectURL(url)
}
</file>

<file path="src/ui/components/Transactions/TransactionTable.tsx">
import { ArrowCounterClockwiseIcon, CheckCircleIcon, TrashIcon } from '@phosphor-icons/react'
import { useMemo, useState } from 'react'
import { v4 as uuid } from 'uuid'
import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from '@/components/ui/select'
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table'
import { addMonths } from '@/domain/calculations'
import { PAYMENT_METHOD_LABELS } from '@/domain/constants'
import type { Transaction } from '@/domain/entities'
import { useFinance } from '@/ui/context'
import AuditLogPanel from '../Common/AuditLogPanel'
import DebtConfigModal from './DebtConfigModal'
import QuickAddRow from './QuickAddRow'
import TransactionForm from './TransactionForm'

interface DebtConfig {
  userShare: number
  splits: Array<{ id: string; name: string; amount: number }>
}

function formatCurrency(n: number): string {
  return `R$ ${n.toFixed(2)}`
}

function PaymentBadge({ method }: { method: string }) {
  const colors: Record<string, string> = {
    CREDIT: 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400',
    DEBIT: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400',
    PIX: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400',
    CASH: 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-400',
    MEAL_VOUCHER: 'bg-teal-100 text-teal-800 dark:bg-teal-900/30 dark:text-teal-400',
  }
  return (
    <Badge variant="outline" className={colors[method] ?? ''}>
      {PAYMENT_METHOD_LABELS[method] ?? method}
    </Badge>
  )
}

function getAvailableMonths(tx: Transaction[]): string[] {
  const months = new Set(tx.map((t) => t.referenceMonth))
  return Array.from(months).sort().reverse()
}

export default function TransactionTable() {
  const { state, dispatch } = useFinance()
  const [showAudit, setShowAudit] = useState(false)
  const [filterMonth, setFilterMonth] = useState<string>('all')
  const [editingTx, setEditingTx] = useState<Transaction | null>(null)
  const [showEditForm, setShowEditForm] = useState(false)
  const [showDebtModal, setShowDebtModal] = useState(false)
  const [debtModalCallback, setDebtModalCallback] = useState<((config: DebtConfig) => void) | null>(
    null,
  )
  const [debtModalAmount, setDebtModalAmount] = useState(0)
  const [tempDebtConfig, setTempDebtConfig] = useState<DebtConfig>({ userShare: 0, splits: [] })

  const months = useMemo(() => getAvailableMonths(state.transactions), [state.transactions])

  const filtered = useMemo(() => {
    let txs = state.transactions
    if (filterMonth !== 'all') {
      txs = txs.filter((t) => t.referenceMonth === filterMonth)
    }
    return txs.sort((a, b) => b.date.localeCompare(a.date))
  }, [state.transactions, filterMonth])

  const displayRefMonth =
    filterMonth !== 'all'
      ? filterMonth
      : `${new Date().getFullYear()}-${String(new Date().getMonth() + 1).padStart(2, '0')}`

  // Get the most recently used payment method for quick-add default
  const lastPaymentMethod = filtered.length > 0 ? filtered[0].paymentMethod : undefined

  function handleQuickAdd(rowData: any, refMonth: string, debtConfig?: DebtConfig) {
    const amount = parseFloat(rowData.amount) || 0
    if (amount <= 0) return

    const tx: Omit<Transaction, 'id'> = {
      type: 'EXPENSE',
      date: rowData.date,
      referenceMonth: refMonth,
      description: rowData.description,
      amount,
      category: rowData.category,
      paymentMethod: rowData.paymentMethod,
      isDebt: !!debtConfig && debtConfig.splits.length > 0,
      debtUserShare: debtConfig ? debtConfig.userShare : undefined,
      debtSplits:
        debtConfig && debtConfig.splits.length > 0
          ? debtConfig.splits.map((s) => ({ debtorName: s.name, amount: s.amount }))
          : undefined,
      isSettled: false,
    }

    if (rowData.paymentMethod === 'CREDIT' && rowData.installmentTotal > 1) {
      const txs = generateInstallments(tx, rowData)
      dispatch({ type: 'ADD_TRANSACTIONS', payload: txs.map((t) => ({ ...t, id: uuid() })) })
    } else {
      dispatch({ type: 'ADD_TRANSACTIONS', payload: [{ ...tx, id: uuid() }] })
    }
  }

  function handleOpenDebtModal(callback: (config: DebtConfig) => void, totalAmount: number) {
    setDebtModalCallback(() => callback)
    setDebtModalAmount(totalAmount)
    setTempDebtConfig({ userShare: 0, splits: [] })
    setShowDebtModal(true)
  }

  function handleDebtModalSave(config: DebtConfig) {
    if (debtModalCallback) {
      debtModalCallback(config)
    }
    setShowDebtModal(false)
  }

  function handleDelete(id: string) {
    dispatch({ type: 'DELETE_TRANSACTION', payload: id })
  }

  function handleSettle(id: string, currently: boolean) {
    dispatch({ type: 'SETTLE_TRANSACTION', payload: id, settled: !currently })
  }

  function handleEdit(tx: Transaction) {
    setEditingTx(tx)
    setShowEditForm(true)
  }

  function handleFormClose(open: boolean) {
    setShowEditForm(open)
    if (!open) setEditingTx(null)
  }

  return (
    <div className="space-y-4">
      <div className="flex items-center justify-between flex-wrap gap-2">
        <div className="flex items-center gap-3">
          <h2 className="text-sm font-semibold">Transactions</h2>
          <Select value={filterMonth} onValueChange={(v) => setFilterMonth(v ?? 'all')}>
            <SelectTrigger className="w-36">
              <SelectValue />
            </SelectTrigger>
            <SelectContent>
              <SelectItem value="all">All months</SelectItem>
              {months.map((m) => (
                <SelectItem key={m} value={m}>
                  {m}
                </SelectItem>
              ))}
            </SelectContent>
          </Select>
          <Button variant="ghost" size="xs" onClick={() => setShowAudit(!showAudit)}>
            <ArrowCounterClockwiseIcon />{' '}
            {state.auditLog.length > 0 ? `Undo (${state.auditLog.length})` : 'History'}
          </Button>
        </div>
      </div>

      {showAudit && <AuditLogPanel onClose={() => setShowAudit(false)} />}

      <div className="border border-border">
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead className="w-20">Ref Month</TableHead>
              <TableHead className="w-20">Date</TableHead>
              <TableHead className="flex-1">Description</TableHead>
              <TableHead className="w-20">Category</TableHead>
              <TableHead className="text-right w-24">Amount</TableHead>
              <TableHead className="w-20">Payment</TableHead>
              <TableHead className="w-16 text-center">Install</TableHead>
              <TableHead className="w-32">Details</TableHead>
              <TableHead className="text-right w-20">Actions</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {/* Quick-add row */}
            <QuickAddRow
              refMonth={displayRefMonth}
              onAdd={handleQuickAdd}
              defaultPaymentMethod={lastPaymentMethod}
              isFilteredMonth={filterMonth !== 'all'}
              onOpenDebtModal={handleOpenDebtModal}
            />

            {filtered.length === 0 && (
              <TableRow>
                <TableCell colSpan={8} className="text-center text-muted-foreground py-12">
                  No transactions yet.
                </TableCell>
              </TableRow>
            )}

            {filtered.map((tx) => (
              <TableRow
                key={tx.id}
                className={`cursor-pointer ${tx.isSettled ? 'opacity-50' : ''}`}
                onClick={() => !tx.parentId && handleEdit(tx)}
              >
                <TableCell className="text-xs text-muted-foreground">{tx.referenceMonth}</TableCell>
                <TableCell className="text-xs text-muted-foreground">{tx.date}</TableCell>
                <TableCell>
                  <div className="max-w-48 truncate">
                    {tx.description}
                    {tx.parentId && (
                      <span className="text-muted-foreground ml-1 text-[10px]">(installment)</span>
                    )}
                  </div>
                </TableCell>
                <TableCell className="text-xs">{tx.category}</TableCell>
                <TableCell
                  className={`text-right font-mono text-xs ${tx.type === 'INCOME' ? 'text-green-600' : ''}`}
                >
                  {formatCurrency(tx.amount)}
                </TableCell>
                <TableCell>
                  <PaymentBadge method={tx.paymentMethod} />
                </TableCell>
                <TableCell className="text-center text-xs">
                  {tx.installment ? (
                    <Badge variant="outline" className="text-xs">
                      {tx.installment.current}/{tx.installment.total}
                    </Badge>
                  ) : null}
                </TableCell>
                <TableCell>
                  {tx.isDebt ? (
                    <div className="text-xs space-y-0.5">
                      {tx.debtUserShare! > 0 && (
                        <div className="text-muted-foreground">
                          Me: {formatCurrency(tx.debtUserShare!)}
                        </div>
                      )}
                      {tx.debtSplits?.map((s, i) => (
                        <div key={i} className="text-muted-foreground">
                          {s.debtorName}: {formatCurrency(s.amount)}
                        </div>
                      ))}
                    </div>
                  ) : null}
                </TableCell>
                <TableCell className="text-right">
                  <div className="flex gap-1 justify-end" onClick={(e) => e.stopPropagation()}>
                    {tx.isDebt && (
                      <Button
                        variant="ghost"
                        size="icon-xs"
                        onClick={() => handleSettle(tx.id, tx.isSettled)}
                        title={tx.isSettled ? 'Unsettle' : 'Settle debt'}
                      >
                        <CheckCircleIcon />
                      </Button>
                    )}
                    <Button variant="ghost" size="icon-xs" onClick={() => handleDelete(tx.id)}>
                      <TrashIcon />
                    </Button>
                  </div>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </div>

      <TransactionForm
        open={showEditForm}
        onOpenChange={handleFormClose}
        editTransaction={editingTx}
      />

      <DebtConfigModal
        open={showDebtModal}
        onOpenChange={setShowDebtModal}
        config={tempDebtConfig}
        onConfigChange={handleDebtModalSave}
        totalAmount={debtModalAmount}
      />
    </div>
  )
}

function generateInstallments(
  tx: Omit<Transaction, 'id'>,
  rowData: any,
): Array<Omit<Transaction, 'id'>> {
  const total = rowData.installmentTotal || 1
  const perInstallment = Math.round(((tx.amount || 0) / total) * 100) / 100
  const groupId = uuid()
  const result: Array<Omit<Transaction, 'id'>> = []

  for (let i = 1; i <= total; i++) {
    result.push({
      ...tx,
      referenceMonth: i === 1 ? tx.referenceMonth : addMonths(tx.referenceMonth, i - 1),
      description: `${tx.description} - ${i}/${total}`,
      amount: i === total ? (tx.amount || 0) - perInstallment * (total - 1) : perInstallment,
      type: 'EXPENSE',
      installment: { current: i, total },
      groupId,
      parentId: groupId,
      isDebt: false,
      isSettled: false,
    })
  }

  return result
}
